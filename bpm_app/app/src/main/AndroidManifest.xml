<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para Android 13+ (API 33+) leitura de áudio via Storage Access Framework -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Captura de áudio para o visualizador BPM (detecção de pitch) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Para versões mais antigas ainda precisamos da permissão legada -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BPMPlayerNative">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver para iniciar música via adb shell (teste/debug) -->
        <receiver
            android:name=".TestPlayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.bpm_player.TEST_PLAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
