<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para Android 13+ (API 33+) leitura de áudio via Storage Access Framework -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Para versões mais antigas ainda precisamos da permissão legada -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BPMPlayerNative">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Telemetria do ONNX Runtime desligada: nenhum dado sai do aparelho. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <!-- BroadcastReceiver para iniciar música via adb shell (teste/debug) -->
        <receiver
            android:name=".TestPlayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.bpm_player.TEST_PLAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
