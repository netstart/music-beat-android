<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient
                android:angle="315"
                android:startColor="#FF1D2935"
                android:endColor="#FF10161D"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="top|end"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#332EE6A8"
                android:endColor="#002EE6A8"/>
        </shape>
    </item>
</layer-list>
