<?xml version="1.0" encoding="utf-8"?>
<!-- Backup na conta Google e troca de aparelho (Android 12+): mesmas regras de backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="manual/" />
        <include domain="sharedpref" path="song_sort.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="manual/" />
        <include domain="sharedpref" path="song_sort.xml" />
    </device-transfer>
</data-extraction-rules>
