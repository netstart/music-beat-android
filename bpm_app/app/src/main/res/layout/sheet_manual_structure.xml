<?xml version="1.0" encoding="utf-8"?>
<!-- Painel deslizante "Estrutura manual" (DESIGN_SYSTEM 4.14): formulário no formato do emusicality -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/manual_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/manualHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/manual_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Música (songs.json) -->
        <TextView
            style="@style/ManualCaption"
            android:text="@string/manual_caption_song" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/manualTitleLayout"
            style="@style/ManualField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/manual_song_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manualTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/ManualField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/manual_song_artist">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/ManualField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/manual_song_genre">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Tempo (breakdown.json: bpm do catálogo, trim, lag) -->
        <TextView
            style="@style/ManualCaption"
            android:text="@string/manual_caption_time" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualBpmLayout"
                style="@style/ManualField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/manual_bpm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualBpm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualTrimLayout"
                style="@style/ManualField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/manual_trim">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualTrim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Põe no "1º tempo" a posição atual da música -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manualTrimNow"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/manual_trim_now"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/bg_icon_button" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/ManualField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/manual_lag">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/manualLag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Seções -->
        <TextView
            style="@style/ManualCaption"
            android:text="@string/manual_caption_sections" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manual_phrases_help"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/manualSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualAddSection"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/manual_add_section"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_icon_button"
            app:icon="@drawable/ic_plus"
            app:iconSize="18dp"
            app:iconTint="@color/text_secondary" />

        <!-- Ações -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/manual_save"
            android:textColor="@color/on_accent"
            app:backgroundTint="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualFill"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/manual_fill"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_icon_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualGitHub"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/manual_github"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_icon_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualDelete"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/manual_delete"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_icon_button"
            app:icon="@drawable/ic_delete"
            app:iconSize="18dp"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
