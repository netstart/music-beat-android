<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="12dp">

    <View
        android:id="@+id/stemColorIndicator"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:background="@color/accent"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Drums"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/stemVolumeSlider"
            style="@style/BeatSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:value="1.0"
            android:valueFrom="0"
            android:valueTo="1"
            android:stepSize="0.01"
            app:trackHeight="3dp"
            app:thumbRadius="6dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stemMuteButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="M"
        android:textSize="10sp"
        android:textColor="@color/text_tertiary"
        android:backgroundTint="@color/bg_icon_button"
        app:cornerRadius="8dp"
        android:layout_marginEnd="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stemSoloButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="S"
        android:textSize="10sp"
        android:textColor="@color/text_tertiary"
        android:backgroundTint="@color/bg_icon_button"
        app:cornerRadius="8dp" />
</LinearLayout>