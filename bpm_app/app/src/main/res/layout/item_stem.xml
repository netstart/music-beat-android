<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de um elemento (stem): ícone · nome · volume · solo · mudo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/stemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="@color/text_secondary"
        tools:src="@drawable/ic_stem_vocals" />

    <TextView
        android:id="@+id/stemName"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="Voz" />

    <com.google.android.material.slider.Slider
        android:id="@+id/stemVolume"
        style="@style/BeatSlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:stepSize="1"
        android:value="100"
        android:valueFrom="0"
        android:valueTo="100"
        app:labelBehavior="gone"
        app:trackHeight="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stemSolo"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:icon="@drawable/ic_headphones"
        app:iconSize="20dp"
        app:iconTint="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stemMute"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:icon="@drawable/ic_volume_up"
        app:iconSize="20dp"
        app:iconTint="@color/text_secondary" />
</LinearLayout>
