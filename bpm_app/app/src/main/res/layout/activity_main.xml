<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_base">

    <!-- ── Conteúdo principal (ScrollView) ── -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="12dp">

            <!-- Hero BPM + controles à direita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Card BPM (esquerda) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/hero_min_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/card_padding"
                    android:paddingVertical="3dp">

                    <FrameLayout
                        android:layout_width="@dimen/hero_icon_size"
                        android:layout_height="@dimen/hero_icon_size"
                        android:background="@drawable/bg_circle">

                        <ImageView
                            android:layout_width="@dimen/hero_icon_inner"
                            android:layout_height="@dimen/hero_icon_inner"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_music_note"
                            android:src="@drawable/ic_music_note" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bpmValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:letterSpacing="-0.02"
                            android:text="120"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/hero_bpm_text_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-3dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="@string/bpm_caption"
                            android:textAllCaps="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Controles à direita -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bpmMinusButton"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/cd_minus"
                            app:backgroundTint="@color/bg_icon_button"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_minus"
                            app:iconGravity="textStart"
                            app:iconSize="14sp"
                            app:iconTint="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bpmPlusButton"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@string/cd_plus"
                            app:backgroundTint="@color/bg_icon_button"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_plus"
                            app:iconGravity="textStart"
                            app:iconSize="14sp"
                            app:iconTint="@color/text_primary" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bpmResetButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/cd_reset"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_reset"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        app:backgroundTint="@color/bg_icon_button"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/tempoFactorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:text="1.00× · tempo original"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BPM Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/bpmSlider"
                style="@style/BeatSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:stepSize="1"
                android:value="120"
                android:valueFrom="40"
                android:valueTo="200"
                app:trackHeight="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="40"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:letterSpacing="0.08"
                    android:text="200"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card da faixa em reprodução -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_top"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/trackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/empty_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/track_title_size" />

                <TextView
                    android:id="@+id/trackStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/empty_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/trackSlider"
                    style="@style/BeatSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:enabled="false"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="1000"
                    app:trackHeight="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/trackTimeCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:text="0:00"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/trackTimeTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:text="--:--"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Espaçador para o rodapé fixo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/footer_spacer" />
        </LinearLayout>
    </ScrollView>

    <!-- ── Rodapé fixo: lista de músicas + botões ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/label_playlist"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/playlist_label_size" />

            <TextView
                android:id="@+id/sortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_sort"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/sort_title"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptySongList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp"
            android:text="@string/empty_song_list"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/songList"
            android:layout_width="match_parent"
            android:layout_height="@dimen/song_list_height"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="4dp" />

        <!-- Botões de controle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:contentDescription="@string/cd_choose"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeatButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_repeat"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_repeat"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loopAllButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_loop_all"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_playlist"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/playFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_play"
                android:enabled="false"
                android:src="@drawable/ic_play"
                app:backgroundTint="@color/accent"
                app:elevation="0dp"
                app:tint="@color/on_accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
