<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <!-- ── Conteúdo principal ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_base"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_primary"
            app:popupTheme="@style/ThemeOverlay.Material3.Dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/screen_padding_top"
                android:paddingBottom="@dimen/footer_spacer">

                <!-- Hero: BPM no centro, ajuste fino nas laterais (padrão metrônomo) -->
                <LinearLayout
                    android:id="@+id/bpmCardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_horizontal"
                    android:minHeight="@dimen/hero_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/card_padding"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/bpmLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/bpm_caption"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bpmMinusButton"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_minus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/bg_icon_button"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_minus"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_primary" />

                        <TextView
                            android:id="@+id/bpmValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.02"
                            android:text="@string/bpm_default"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/hero_bpm_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bpmPlusButton"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_plus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/bg_icon_button"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_plus"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bpmResetButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:contentDescription="@string/cd_reset"
                            android:paddingHorizontal="16dp"
                            android:text="@string/btn_reset"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:backgroundTint="@color/bg_icon_button"
                            app:cornerRadius="999dp" />

                        <TextView
                            android:id="@+id/tempoFactorValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFeatureSettings="tnum"
                            android:text="1.00× · tempo original"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/bpmSlider"
                    style="@style/BeatSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/cd_bpm_slider"
                    android:stepSize="1"
                    android:value="120"
                    android:valueFrom="40"
                    android:valueTo="200"
                    app:thumbHeight="28dp"
                    app:trackHeight="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/bpm_range_min"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="end"
                        android:letterSpacing="0.08"
                        android:text="@string/bpm_range_max"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card da faixa em reprodução -->
                <LinearLayout
                    android:id="@+id/nowPlayingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_top"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/trackTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/empty_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/track_title_size" />

                        <TextView
                            android:id="@+id/trackBpmValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/accent"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="120" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/trackStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/empty_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/trackSlider"
                        style="@style/BeatSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/cd_track_slider"
                        android:enabled="false"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="1000"
                        app:thumbHeight="24dp"
                        app:trackHeight="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/trackTimeCurrent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:text="0:00"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/track_time_size" />

                        <TextView
                            android:id="@+id/trackTimeTotal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:gravity="end"
                            android:text="--:--"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/track_time_size" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card Estrutura: seções, frases e contagem 1–8 (DESIGN_SYSTEM 4.13) -->
                <LinearLayout
                    android:id="@+id/structureCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_top"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/structure_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/track_title_size" />

                    <TextView
                        android:id="@+id/structureStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/structure_idle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/structureProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/outline"
                        app:trackCornerRadius="2dp" />

                    <com.example.bpm_player.StructureBarView
                        android:id="@+id/structureBar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/cd_structure_bar"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/structureLive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/sectionName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textSize="@dimen/track_title_size" />

                            <TextView
                                android:id="@+id/phraseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.example.bpm_player.CountView
                            android:id="@+id/countView"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackground"
                            android:layout_marginTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/phrasePrevButton"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/cd_phrase_previous"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/bg_icon_button"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_skip_previous"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/phraseLoopButton"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/cd_phrase_loop"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/bg_icon_button"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_repeat"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/phraseNextButton"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/cd_phrase_next"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:backgroundTint="@color/bg_icon_button"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_skip_next"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/structureAnalyze"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/btn_analyze"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_icon_button" />

                        <!-- Apaga a análise salva da música atual -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/structureDelete"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/btn_delete_analysis"
                            android:textColor="@color/text_primary"
                            android:visibility="gone"
                            app:backgroundTint="@color/bg_icon_button"
                            app:icon="@drawable/ic_delete"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Abre o painel "Estrutura manual" (DESIGN_SYSTEM 4.14) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/structureManual"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/manual_open"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/bg_icon_button"
                        app:icon="@drawable/ic_edit"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_secondary" />
                </LinearLayout>

                <!-- Card Elementos: separação de stems on-device + mesa (solo/mudo/volume) -->
                <LinearLayout
                    android:id="@+id/elementsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_top"
                    android:layout_marginBottom="@dimen/card_margin_top"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/elements_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/track_title_size" />

                    <TextView
                        android:id="@+id/elementsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/elements_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/elementsProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:visibility="gone"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/outline"
                        app:trackCornerRadius="2dp" />

                    <LinearLayout
                        android:id="@+id/stemRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/elementsAction"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:minHeight="48dp"
                            android:text="@string/btn_separate"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_icon_button" />

                        <!-- Apaga os elementos da música atual e volta ao áudio original -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/elementsClear"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/btn_clear_elements"
                            android:textColor="@color/text_primary"
                            android:visibility="gone"
                            app:backgroundTint="@color/bg_icon_button"
                            app:icon="@drawable/ic_delete"
                            app:iconSize="18dp"
                            app:iconTint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Banner AdMob: último item da área que rola; some até carregar (ver docs/MONETIZACAO.md) -->
                <FrameLayout
                    android:id="@+id/adContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_top"
                    android:visibility="gone" />
            </LinearLayout>
            </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Lista de músicas: painel inferior arrastável (DESIGN_SYSTEM.md 4.7) ──
         Recolhido: só o cabeçalho, logo acima dos controles. Aberto: a lista; os controles seguem visíveis.
         As margens de cima (toolbar) e de baixo (rodapé) são ajustadas no código conforme os insets. -->
    <LinearLayout
        android:id="@+id/songSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/sheet_peek"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/songSheetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/cd_songs_expand"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sheet_handle"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/songsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.08"
                    android:text="@string/drawer_playlist_title"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/playlist_label_size" />

                <TextView
                    android:id="@+id/sortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/cd_sort"
                    android:drawableStart="@drawable/ic_sort"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="8dp"
                    android:text="@string/sort_title"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/emptySongList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp"
            android:text="@string/empty_song_list"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/songList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Rodapé fixo: por cima do painel de músicas (vem depois dele no XML) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:contentDescription="@string/cd_choose"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repeatButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_repeat"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_repeat"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loopAllButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_loop_all"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_loop_all"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipPreviousButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_skip_previous"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_skip_previous"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/playFab"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/cd_play"
                android:src="@drawable/ic_play"
                app:backgroundTint="@color/accent"
                app:tint="@color/on_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipNextButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/footer_button_height"
                android:layout_height="@dimen/footer_button_height"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_skip_next"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/bg_icon_button"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_skip_next"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>